{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run src/eval/run.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
